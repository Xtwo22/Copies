<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alphabet Coloring Pages - A to Z</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            size: A4 landscape;
            margin: 10mm;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f0f0f0;
        }

        .page {
            width: 277mm; /* A4 landscape width minus margins */
            height: 190mm; /* A4 landscape height minus margins */
            display: flex;
            justify-content: center;
            align-items: center;
            page-break-after: always;
            background: white;
            margin: 5mm auto;
            position: relative;
            overflow: hidden;
        }

        .page:last-child {
            page-break-after: auto;
        }

        .letter-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 5mm;
            width: 100%;
            height: 100%;
        }

        .letter {
            font-family: 'Arial Black', 'Arial', sans-serif;
            font-weight: 900;
            color: transparent;
            -webkit-text-stroke: 3px #333;
            text-stroke: 3px #333;
            paint-order: stroke fill;
            user-select: none;
            
